# Where website form submissions (Trial / Demo / Contact) are delivered.
#
# The site is a static build, so leads are relayed by a form-to-email service.
# Default provider: Web3Forms (https://web3forms.com) — enter the inbox address
# there and it emails back an access key; no account needed.
#
# In production these come from the GitHub Actions workflow
# (VITE_LEAD_ACCESS_KEY is read from the LEAD_ACCESS_KEY repository secret).
VITE_LEAD_ACCESS_KEY=""
VITE_LEAD_EMAIL="gimedashvili7@gmail.com"
# Optional — override to use a different provider (Formspree, Getform, ...)
# VITE_LEAD_ENDPOINT="https://api.web3forms.com/submit"
